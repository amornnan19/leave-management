# =============================================================================
# Leave Management — Production Environment Template
# =============================================================================
# Copy this file to .env (or paste values into Coolify's environment section).
# IMPORTANT: All values with a blank = MUST be set before the container starts.
#
# Persistent volume required:
#   Mount a Coolify persistent volume to: /var/www/html/storage/app
#   This directory holds:
#     - SQLite database  →  storage/app/database.sqlite
#     - File uploads     →  storage/app/public/
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Leave Management"
APP_ENV=production
APP_DEBUG=false

# REQUIRED — generate with: php artisan key:generate --show
APP_KEY=

APP_URL=https://leave-management.ghostshift.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---------------------------------------------------------------------------
# Database (SQLite on persistent volume)
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

# ---------------------------------------------------------------------------
# Session / Cache / Queue (all use database driver via SQLite)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Filesystem
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------------
# Logging — stderr routes logs to Coolify's log viewer
# ---------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Mail (log driver — no real SMTP needed; change for production sending)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@leave-management.ghostshift.tech"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# serversideup/php AUTORUN — baked into the image; documented here for clarity
#
# These vars are set as ENV defaults in the Dockerfile and will run on every
# container start. You can override them here if needed.
# ---------------------------------------------------------------------------
AUTORUN_ENABLED=true
AUTORUN_LARAVEL_MIGRATION=true
AUTORUN_LARAVEL_STORAGE_LINK=true
AUTORUN_LARAVEL_CONFIG_CACHE=true
AUTORUN_LARAVEL_ROUTE_CACHE=true
AUTORUN_LARAVEL_VIEW_CACHE=true
AUTORUN_LARAVEL_EVENT_CACHE=true

# ---------------------------------------------------------------------------
# PHP OPcache
# ---------------------------------------------------------------------------
PHP_OPCACHE_ENABLE=1

# ---------------------------------------------------------------------------
# Coolify deployment summary
# ---------------------------------------------------------------------------
# Build pack      : Dockerfile
# Exposed port    : 8080
# Persistent vol  : /var/www/html/storage/app
# Required secret : APP_KEY  (generate once, store in Coolify secrets)
# ---------------------------------------------------------------------------
